{
  "name": "filebrowser-frontend",
  "version": "3.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run typecheck && pnpm run clean && vite build",
    "clean": "find ./dist -maxdepth 1 -mindepth 1 ! -name '.gitkeep' -exec rm -r {} +",
    "typecheck": "pnpm run typecheck:vue && pnpm run typecheck:native && pnpm run typecheck:config",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck:vue": "vue-tsc -p ./tsconfig.app.json --noEmit",
    "typecheck:native": "tsc -p ./tsconfig.native.json --noEmit",
    "typecheck:config": "tsc -p ./tsconfig.node.json --noEmit",
    "test:browser": "playwright test",
    "audit": "pnpm audit"
  },
  "dependencies": {
    "@chenfengyuan/vue-number-input": "2.0.1",
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "ace-builds": "1.45.2",
    "csv-parse": "7.0.3",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "epubjs": "0.3.93",
    "filesize": "11.0.29",
    "js-base64": "3.9.6",
    "jwt-decode": "4.0.0",
    "lodash-es": "4.18.1",
    "marked": "18.1.2",
    "marked-katex-extension": "5.1.13",
    "material-icons": "1.13.14",
    "normalize.css": "8.0.1",
    "pinia": "4.1.0",
    "pretty-bytes": "7.2.0",
    "qrcode.vue": "3.11.0",
    "tus-js-client": "4.3.1",
    "utif": "3.1.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.17",
    "vue-lazyload": "3.0.0",
    "vue-reader": "1.3.9",
    "vue-router": "5.4.0",
    "vue-toastification": "2.0.0-rc.5",
    "@videojs/html": "10.2.0",
    "@vue/devtools-api": "8.2.1",
    "katex": "0.19.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.12.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "terser": "5.51.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vite-plugin-compression2": "2.5.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14",
    "@tsconfig/node26": "26.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@playwright/test": "1.64.1",
    "rollup": "4.67.4",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3"
  },
  "packageManager": "pnpm@12.16.1"
}
